{
  "name": "jungle-run",
  "version": "1.0.0",
  "description": "Jungle Run \u2014 an endless temple-runner played in the browser: original WebGL engine, generated art pipeline and synthesized WebAudio soundtrack.",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs 4173",
    "serve": "node tools/serve.mjs 4173",
    "test": "node tools/check_wiring.mjs && node tools/scene_test.mjs && node tools/headless_test.mjs --seeds 6 --seconds 200",
    "test:wiring": "node tools/check_wiring.mjs",
    "test:scene": "node tools/scene_test.mjs",
    "test:play": "node tools/headless_test.mjs --seeds 8 --seconds 300",
    "assets": "python3 tools/process_assets.py",
    "vendor": "node tools/vendor_three.mjs",
    "serve:py": "python3 -m http.server 4173 --bind 0.0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvinddarabishnoi/runner.git"
  },
  "keywords": [
    "game",
    "endless-runner",
    "temple-run",
    "three.js",
    "webgl",
    "canvas"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/arvinddarabishnoi/runner/issues"
  },
  "homepage": "https://github.com/arvinddarabishnoi/runner#readme",
  "dependencies": {
    "three": "^0.186.1"
  },
  "private": true
}
